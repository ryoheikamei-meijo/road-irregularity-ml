# ローカル開発用(compose.yaml の値と同じ)。コピーして .env にする。.env は git に入れない。
PORT=8787
API_KEY=dev-shared-key-change-me
DATABASE_URL=postgres://roadml:roadml-dev@127.0.0.1:5433/roadml
S3_ENDPOINT=http://127.0.0.1:8333
# 署名付き URL に入れるホスト(クライアントから見える名前)。PC からは 127.0.0.1、Android エミュレーターからは 10.0.2.2。
S3_PUBLIC_ENDPOINT=http://127.0.0.1:8333
S3_BUCKET=roadml-raw
S3_ACCESS_KEY=roadml-dev
S3_SECRET_KEY=roadml-dev-secret
S3_REGION=us-east-1
