<?xml version="1.0" encoding="utf-8"?>
<!-- Android 公式の Material Design 3。地図(OpenFreeMap の liberty)が明るい色なので、明るいテーマにそろえる -->
<resources>
    <style name="Theme.RoadDetector" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorOnPrimaryContainer">@color/on_primary_container</item>
        <item name="colorSecondaryContainer">@color/secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/on_secondary_container</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant</item>
        <item name="colorOutline">@color/outline</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <!-- ダイアログとスナックバーの文字も 16sp にする(Material の標準は 14sp) -->
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.RoadDetector.Dialog</item>
        <item name="snackbarTextViewStyle">@style/RoadDetector.Snackbar.Text</item>
        <item name="snackbarButtonStyle">@style/RoadDetector.Snackbar.Button</item>
    </style>

    <style name="ThemeOverlay.RoadDetector.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="materialAlertDialogBodyTextStyle">@style/RoadDetector.Dialog.Body</item>
        <item name="buttonBarPositiveButtonStyle">@style/RoadDetector.Dialog.Button</item>
        <item name="buttonBarNegativeButtonStyle">@style/RoadDetector.Dialog.Button</item>
    </style>
    <style name="RoadDetector.Dialog.Body" parent="MaterialAlertDialog.Material3.Body.Text">
        <item name="android:textSize">16sp</item>
        <item name="android:lineHeight">24sp</item>
    </style>
    <style name="RoadDetector.Dialog.Button" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textSize">16sp</item>
        <item name="android:minHeight">48dp</item>
    </style>
    <style name="RoadDetector.Snackbar.Text" parent="Widget.Material3.Snackbar.TextView">
        <item name="android:textSize">16sp</item>
    </style>
    <style name="RoadDetector.Snackbar.Button" parent="Widget.Material3.Button.TextButton.Snackbar">
        <item name="android:textSize">16sp</item>
    </style>

    <!-- 文字。デジタル庁デザインシステムの「本文・UI は 16px 以上」「行の高さは 1.5 倍以上」に合わせる -->
    <style name="TextAppearance.RoadDetector.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">16sp</item>
        <item name="android:lineHeight">24sp</item>
        <item name="android:textColor">@color/on_surface</item>
    </style>
    <style name="TextAppearance.RoadDetector.Body.Variant">
        <item name="android:textColor">@color/on_surface_variant</item>
    </style>
    <style name="TextAppearance.RoadDetector.Result" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textSize">28sp</item>
        <item name="android:lineHeight">42sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextAppearance.RoadDetector.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">20sp</item>
        <item name="android:lineHeight">30sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
