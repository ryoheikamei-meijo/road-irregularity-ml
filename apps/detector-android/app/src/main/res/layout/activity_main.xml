<?xml version="1.0" encoding="utf-8"?>
<!--
  地図の画面。Material Design 3 の部品で作り、文字・色・ボタンはデジタル庁デザインシステムを参考にする
  (文字 16sp 以上、塗りのボタンは 1 画面に 1 つ、押せる範囲 48dp 以上。出典：デジタル庁デザインシステムウェブサイト https://design.digital.go.jp/dads/)
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <org.maplibre.android.maps.MapView
        android:id="@+id/map"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 上: 状態・直近の判定・数・線の凡例のカードと、段差・凸凹を出す・隠すチップ(段差・凸凹の凡例を兼ねる) -->
    <LinearLayout
        android:id="@+id/top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"
        android:orientation="vertical">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card"
            style="@style/Widget.Material3.CardView.Elevated"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="8dp"
                android:paddingEnd="8dp"
                android:paddingBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_status_stopped"
                        android:paddingStart="12dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="4dp"
                        android:text="@string/status_stopped"
                        android:textAppearance="@style/TextAppearance.RoadDetector.Body"
                        android:textStyle="bold" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/dev"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/button_dev"
                        android:textSize="16sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/resultRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/resultIcon"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_marginEnd="8dp"
                        android:importantForAccessibility="no"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/result"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/class_none"
                        android:textAppearance="@style/TextAppearance.RoadDetector.Result" />

                    <TextView
                        android:id="@+id/resultCaption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/latest_result"
                        android:textAppearance="@style/TextAppearance.RoadDetector.Body.Variant" />
                </LinearLayout>

                <TextView
                    android:id="@+id/counts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.RoadDetector.Body" />

                <!-- 線の凡例。段差・凸凹の凡例は、下のチップが兼ねる -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:drawablePadding="4dp"
                        android:text="@string/legend_live"
                        android:textAppearance="@style/TextAppearance.RoadDetector.Body"
                        app:drawableStartCompat="@drawable/legend_line_live" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:drawablePadding="4dp"
                        android:text="@string/legend_past"
                        android:textAppearance="@style/TextAppearance.RoadDetector.Body"
                        app:drawableStartCompat="@drawable/legend_line_past" />
                </LinearLayout>

                <TextView
                    android:id="@+id/info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textAppearance="@style/TextAppearance.RoadDetector.Body.Variant"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!--
          段差・凸凹を地図に出す・隠す。出しているときは塗りと印、隠しているときは枠だけで印も消す(色だけで状態を伝えない)。
          押せる範囲は 48dp
        -->
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            app:chipSpacingHorizontal="8dp"
            app:singleLine="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipStep"
                style="@style/Widget.Material3.Chip.Filter.Elevated"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/chip_step"
                android:textSize="16sp"
                app:checkedIconVisible="false"
                app:chipIcon="@drawable/ic_pin_step"
                app:chipIconSize="24dp"
                app:chipIconVisible="true"
                app:chipMinHeight="40dp"
                app:ensureMinTouchTargetSize="true" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipRough"
                style="@style/Widget.Material3.Chip.Filter.Elevated"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/chip_rough"
                android:textSize="16sp"
                app:checkedIconVisible="false"
                app:chipIcon="@drawable/ic_legend_rough"
                app:chipIconSize="24dp"
                app:chipIconVisible="true"
                app:chipMinHeight="40dp"
                app:ensureMinTouchTargetSize="true" />
        </com.google.android.material.chip.ChipGroup>
    </LinearLayout>

    <!-- 下: 現在地(副) と 判定の開始・停止(主。塗りは 1 画面に 1 つ)。地図の出典の表示(左下)と重ならないよう上げる -->
    <LinearLayout
        android:id="@+id/bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="44dp"
        android:gravity="center_vertical|end"
        android:orientation="horizontal">

        <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
            android:id="@+id/here"
            style="@style/Widget.Material3.ExtendedFloatingActionButton.Icon.Surface"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:contentDescription="@string/here_description"
            android:text="@string/button_here"
            android:textSize="16sp"
            app:icon="@drawable/ic_my_location" />

        <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
            android:id="@+id/run"
            style="@style/Widget.Material3.ExtendedFloatingActionButton.Icon.Primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/button_start"
            android:textSize="16sp"
            app:backgroundTint="@color/primary"
            app:icon="@drawable/ic_play_arrow"
            app:iconTint="@color/on_primary"
            android:textColor="@color/on_primary" />
    </LinearLayout>
</FrameLayout>
